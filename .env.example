HOST=127.0.0.1
PORT=3210
# At least 16 characters. Keep secrets only in this file, never in the browser.
ADMIN_PASSWORD=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# 64 hexadecimal characters; generated by npm run setup. Protect together with .env.
ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OWNER_NAME=
# Enable only behind an HTTPS reverse proxy.
COOKIE_SECURE=false
# Comma-separated hostname(s) when using an HTTPS reverse proxy.
ALLOWED_HOSTS=
DATA_FILE=./data/store.enc
